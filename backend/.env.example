# Copie este archivo como ".env" (en esta misma carpeta) y complete los valores.
# El archivo .env no se sube al repositorio.

PORT=3000

# Base de datos PostgreSQL
DATABASE_URL=postgres://usuario:clave@localhost:5432/mediconect
# "true" solo si la base de datos está en otro servidor y exige conexión cifrada
DATABASE_SSL=false

# Firma de las sesiones: un texto largo y aleatorio. Se genera con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Administrador que se crea la primera vez (npm run db:seed).
# La contraseña: mínimo 10 caracteres, con letras y números, sin espacios.
ADMIN_USUARIO=admin
ADMIN_CLAVE=

# Clave con la que el sistema de la IPS envía las fórmulas (cabecera x-api-key de /api/ips)
IPS_API_KEY=

# "true" activa el simulador de la IPS (/ips/) y los botones de prueba del inventario.
# En el sitio real debe ser "false".
MODO_DEMO=true
# Médico de prueba del simulador (solo con MODO_DEMO=true). Sin MEDICO_CLAVE no se crea.
MEDICO_USUARIO=doctor
MEDICO_CLAVE=

# Correo (opcional): sin estos datos, los correos se escriben en la consola del servidor
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CLAVE=
CORREO_REMITENTE=

# Dirección pública del sitio: se usa en los enlaces de los correos y limita el origen de las peticiones.
# Vacía en el equipo local (los enlaces usan http://localhost:5174); en Render se toma de RENDER_EXTERNAL_URL.
URL_SITIO=
# Opcional: archivo de texto con la dirección pública actual (túnel de pruebas); tiene prioridad en los correos
URL_SITIO_ARCHIVO=

# Avisos al celular (opcional). Se generan una vez con: npx web-push generate-vapid-keys
VAPID_PUBLICA=
VAPID_PRIVADA=
# Contacto que exige el servicio de avisos (opcional: por defecto usa CORREO_REMITENTE o URL_SITIO)
VAPID_CONTACTO=
